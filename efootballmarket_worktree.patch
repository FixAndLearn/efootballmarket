+  NEW.seller_rating := OLD.seller_rating;
+  NEW.total_reviews_count := OLD.total_reviews_count;
+  NEW.completed_sales_count := OLD.completed_sales_count;
+  NEW.is_suspended := OLD.is_suspended;
+  RETURN NEW;
+END;
+$function$;
