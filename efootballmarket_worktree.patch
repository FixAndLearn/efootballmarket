+CREATE OR REPLACE FUNCTION public.decrement_listing_favorites(listing_id uuid)
+ RETURNS void
+ LANGUAGE sql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+  UPDATE public.listings
+  SET favorites_count = GREATEST(0, COALESCE(favorites_count, 0) - 1)
+  WHERE id = listing_id;
+$function$;
